{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asymmetric predictive validity audit eval telemetry event",
  "type": "object",
  "required": ["schema", "event", "timestamp", "eval_run_id"],
  "properties": {
    "schema": {"const": "apva.eval.telemetry.v1"},
    "event": {"type": "string"},
    "timestamp": {"type": "string"},
    "eval_run_id": {"type": "string"},
    "case_id": {"type": ["string", "null"]},
    "suite": {"type": ["string", "null"]},
    "condition": {"type": ["string", "null"]},
    "repeat": {"type": ["integer", "null"]},
    "data": {"type": "object"}
  },
  "additionalProperties": true
}
