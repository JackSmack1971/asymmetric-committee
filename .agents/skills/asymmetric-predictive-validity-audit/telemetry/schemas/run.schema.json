{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APVA evaluation run manifest",
  "type": "object",
  "required": ["schema", "eval_run_id", "created_at", "skill", "production_fingerprint", "corpus_sha256", "case_ids", "routing_evidence"],
  "properties": {
    "schema": {"const": "apva.eval.run.v1"},
    "eval_run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "skill": {"const": "asymmetric-predictive-validity-audit"},
    "production_fingerprint": {"type": "string"},
    "corpus_sha256": {"type": "string"},
    "codex_version": {"type": ["string", "null"]},
    "requested_model": {"type": ["string", "null"]},
    "case_ids": {"type": "array", "items": {"type": "string"}},
    "routing_evidence": {"const": "native_otel_codex.skill.injected"}
  },
  "additionalProperties": true
}
