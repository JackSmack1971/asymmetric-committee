# Copy to .env (git-ignored). Never commit real secrets.

# Storage / queue
DATABASE_URL=postgresql+psycopg://committee:committee@localhost:5432/committee
REDIS_URL=redis://localhost:6379/0

# LLM layer (§10)
OPENROUTER_API_KEY=

# Alpaca — paper trading ONLY (§9). Live endpoints are a bug.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# SEC EDGAR (§4.1) — required User-Agent with contact email
SEC_USER_AGENT=AsymmetricCommittee/1.0 (you@domain)

# News (§18 open decision): alpaca | alphavantage
NEWS_PROVIDER=alpaca
ALPHAVANTAGE_API_KEY=

# Per-run LLM spend cap in USD (§10.2)
RUN_BUDGET_USD=10

# Tests (optional): point at existing servers; otherwise tests start throwaway local ones.
# TEST_DATABASE_URL=postgresql+psycopg://committee:committee@localhost:5432/committee
# TEST_REDIS_URL=redis://localhost:6379/15
# Local Postgres without TimescaleDB: skip hypertables (tests only; compose/CI run TimescaleDB).
# STORE_ALLOW_PLAIN_POSTGRES=1
